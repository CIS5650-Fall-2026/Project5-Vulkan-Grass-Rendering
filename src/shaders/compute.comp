#version 450
#extension GL_GOOGLE_include_directive : require

#include "frame_uniform.glsl"

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

layout(std430, set = 1, binding = 0) buffer PersistentBlades {
    Blade blades[];
} persistent;

const float EPSILON = 1.0e-6;
const uint FORCE_BIT = 1u;
const uint INTERACTION_BIT = 2u;

bool finiteFloat(float value) {
    return !isnan(value) && !isinf(value);
}

bool finiteVec3(vec3 value) {
    return !any(isnan(value)) && !any(isinf(value));
}

vec3 safeNormalize(vec3 value, vec3 fallbackValue) {
    float lengthSquared = dot(value, value);
    if (!finiteVec3(value) || !finiteFloat(lengthSquared)
            || lengthSquared <= EPSILON * EPSILON) {
        return fallbackValue;
    }
    return value * inversesqrt(lengthSquared);
}

vec3 makeLateral(vec3 normal, float encodedAngle) {
    vec3 reference = abs(normal.y) < 0.95 ? vec3(0.0, 1.0, 0.0)
                                          : vec3(1.0, 0.0, 0.0);
    vec3 base = safeNormalize(cross(reference, normal), vec3(1.0, 0.0, 0.0));
    vec3 second = safeNormalize(cross(normal, base), vec3(0.0, 0.0, 1.0));
    float angle = finiteFloat(encodedAngle) ? encodedAngle : 0.0;
    return safeNormalize(cos(angle) * base + sin(angle) * second, base);
}

float bladeHeight(float encodedHeight) {
    return finiteFloat(encodedHeight) ? max(encodedHeight, EPSILON) : 1.0;
}

void resetSpatialState(inout Blade blade) {
    vec3 root = finiteVec3(blade.v0.xyz) ? blade.v0.xyz : vec3(0.0);
    vec3 normal = safeNormalize(blade.up.xyz, vec3(0.0, 1.0, 0.0));
    float height = bladeHeight(blade.v1.w);
    blade.v0.xyz = root;
    blade.v1.xyz = root + height * normal;
    blade.v2.xyz = root + height * normal;
    blade.up.xyz = normal;
}

// Paper section 5.2: ground first, then the approximate arc-length correction.
void constrainBlade(vec3 root, vec3 normal, float height,
                    inout vec3 guide, inout vec3 tip) {
    tip -= normal * min(dot(normal, tip - root), 0.0);

    vec3 offset = tip - root;
    float projectedLength = length(offset - normal * dot(offset, normal));
    float projectedRatio = projectedLength / height;
    guide = root + height * normal
          * max(1.0 - projectedRatio, 0.05 * max(projectedRatio, 1.0));

    float approximateLength = (2.0 * length(tip - root)
                             + length(guide - root)
                             + length(tip - guide)) / 3.0;
    float scale = height / max(approximateLength, EPSILON);
    guide = root + (guide - root) * scale;
    tip = root + (tip - root) * scale;
}

vec3 windAt(vec3 root) {
    vec3 baseWind = finiteVec3(frame.wind.xyz) ? frame.wind.xyz : vec3(0.0);
    float windMagnitude = length(baseWind);
    if (!finiteFloat(windMagnitude) || windMagnitude <= EPSILON) {
        return vec3(0.0);
    }

    float frequency = finiteFloat(frame.wind.w) ? abs(frame.wind.w) : 0.0;
    float time = finiteFloat(frame.cameraTime.w) ? frame.cameraTime.w : 0.0;
    float phaseA = dot(root, vec3(0.071, 0.037, 0.113)) + time * frequency;
    float phaseB = dot(root, vec3(-0.043, 0.019, 0.067))
                 - time * frequency * 0.61;
    float gust = max(0.15, 0.72 + 0.22 * sin(phaseA) + 0.10 * sin(2.17 * phaseB));
    vec3 drift = vec3(sin(phaseB), 0.18 * sin(0.47 * phaseA), cos(0.83 * phaseA));
    return baseWind * gust + drift * (0.10 * windMagnitude);
}

float spherePenetration(vec3 point, vec3 center, float radius,
                        vec3 fallbackDirection, out vec3 correction) {
    correction = vec3(0.0);
    vec3 offset = point - center;
    float distanceToCenter = length(offset);
    if (!finiteFloat(distanceToCenter) || distanceToCenter >= radius) {
        return 0.0;
    }
    vec3 direction = distanceToCenter > EPSILON
                   ? offset / distanceToCenter
                   : fallbackDirection;
    float penetration = radius - distanceToCenter;
    correction = direction * penetration;
    return penetration;
}

void main() {
    uint index = gl_GlobalInvocationID.x;
    if (index >= frame.flags.x) {
        return;
    }
    if (!finiteFloat(frame.parameters.x) || frame.parameters.x <= 0.0) {
        return;
    }

    Blade blade = persistent.blades[index];
    bool forcesEnabled = (frame.flags.w & FORCE_BIT) != 0u;
    bool interactionEnabled = (frame.flags.w & INTERACTION_BIT) != 0u;

    // A valid static blade must remain byte-for-byte unchanged.
    if (!forcesEnabled && !interactionEnabled) {
        float normalLengthSquared = dot(blade.up.xyz, blade.up.xyz);
        if (!finiteVec3(blade.v0.xyz) || !finiteVec3(blade.v1.xyz)
                || !finiteVec3(blade.v2.xyz) || !finiteVec3(blade.up.xyz)
                || !finiteFloat(normalLengthSquared)
                || normalLengthSquared <= EPSILON * EPSILON) {
            resetSpatialState(blade);
            persistent.blades[index] = blade;
        }
        return;
    }

    vec3 root = finiteVec3(blade.v0.xyz) ? blade.v0.xyz : vec3(0.0);
    vec3 normal = safeNormalize(blade.up.xyz, vec3(0.0, 1.0, 0.0));
    float height = bladeHeight(blade.v1.w);
    vec3 guide = finiteVec3(blade.v1.xyz) ? blade.v1.xyz : root + height * normal;
    vec3 tip = finiteVec3(blade.v2.xyz) ? blade.v2.xyz : root + height * normal;
    vec3 lateral = makeLateral(normal, blade.v0.w);
    vec3 front = safeNormalize(cross(lateral, normal), vec3(0.0, 0.0, 1.0));

    if (forcesEnabled) {
        float dt = finiteFloat(frame.parameters.x)
                 ? clamp(frame.parameters.x, 0.0, 1.0 / 30.0)
                 : 0.0;
        vec3 initialTip = root + height * normal;
        float stiffness = finiteFloat(blade.up.w) ? blade.up.w : 0.0;
        vec3 recovery = (initialTip - tip) * stiffness;
        vec3 environmental = finiteVec3(frame.gravity.xyz) ? frame.gravity.xyz : vec3(0.0);
        float frontFactor = finiteFloat(frame.gravity.w) ? frame.gravity.w : 0.0;
        vec3 frontGravity = frontFactor * length(environmental) * front;

        vec3 localWind = windAt(root);
        vec3 tipOffset = tip - root;
        float windLength = length(localWind);
        float tipLength = length(tipOffset);
        vec3 windForce = vec3(0.0);
        if (finiteFloat(windLength) && finiteFloat(tipLength)
                && windLength > EPSILON && tipLength > EPSILON) {
            float directionalAlignment = 1.0
                - abs(dot(localWind / windLength, tipOffset / tipLength));
            float heightRatio = clamp(dot(tipOffset, normal) / height, 0.0, 1.0);
            windForce = localWind * directionalAlignment * heightRatio;
        }

        tip += (recovery + environmental + frontGravity + windForce) * dt;
        constrainBlade(root, normal, height, guide, tip);
    }

    if (interactionEnabled && finiteVec3(frame.collider.xyz)
            && finiteFloat(frame.collider.w) && frame.collider.w > EPSILON) {
        vec3 center = frame.collider.xyz;
        float radius = frame.collider.w;
        float correctionLimit = 0.25 * height;

        for (int iteration = 0; iteration < 4; ++iteration) {
            float deepestPenetration = 0.0;
            float deepestParameter = 1.0;
            vec3 deepestCorrection = vec3(0.0);

            for (int sampleIndex = 0; sampleIndex < 4; ++sampleIndex) {
                float curveParameter = 0.25 * float(sampleIndex + 1);
                float oneMinusParameter = 1.0 - curveParameter;
                vec3 point = oneMinusParameter * oneMinusParameter * root
                           + 2.0 * oneMinusParameter * curveParameter * guide
                           + curveParameter * curveParameter * tip;
                vec3 pointCorrection;
                float penetration = spherePenetration(
                    point, center, radius, lateral, pointCorrection);
                if (penetration > deepestPenetration) {
                    deepestPenetration = penetration;
                    deepestParameter = curveParameter;
                    deepestCorrection = pointCorrection;
                }
            }

            if (deepestPenetration <= EPSILON) {
                break;
            }

            // A quadratic Bezier point inherits t^2 of a physical-tip change.
            vec3 tipCorrection = deepestCorrection
                               / (deepestParameter * deepestParameter);
            float tipCorrectionLength = length(tipCorrection);
            if (!finiteFloat(tipCorrectionLength)
                    || tipCorrectionLength <= EPSILON) {
                break;
            }
            float appliedLength = min(tipCorrectionLength, correctionLimit);
            tip += tipCorrection * (appliedLength / tipCorrectionLength);
            constrainBlade(root, normal, height, guide, tip);
        }
    }

    blade.v0.xyz = root;
    blade.v1.xyz = guide;
    blade.v2.xyz = tip;
    blade.up.xyz = normal;
    if (!finiteVec3(blade.v0.xyz) || !finiteVec3(blade.v1.xyz)
            || !finiteVec3(blade.v2.xyz) || !finiteVec3(blade.up.xyz)) {
        resetSpatialState(blade);
    }
    persistent.blades[index] = blade;
}

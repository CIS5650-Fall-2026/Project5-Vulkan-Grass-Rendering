// All blades. Each invocation reads one and writes the updated v1/v2 back.
layout(set = 2, binding = 0) buffer BladeBuffer {
    Blade blades[];
};

layout(set = 2, binding = 1) buffer CulledBladeBuffer {
    Blade culledBlades[];
};

layout(set = 2, binding = 2) buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

// 1 = zero the indirect counter. 0 = simulate and cull. Split so every workgroup
// sees a cleared counter; a workgroup barrier cannot do that by itself.
layout(push_constant) uniform SimulationPush {
    uint resetOnly;
} push;

// Paper orientation test: cull when the view direction is nearly parallel to the blade width.
const float ORIENTATION_THRESHOLD = 0.9;
// Added to clip-space w so blades that only stick into the frustum by their width survive.
const float FRUSTUM_TOLERANCE = 1.0;
// Past this projected distance every blade is dropped. Buckets thin the field before that.
const float MAX_CULL_DISTANCE = 45.0;
const uint DISTANCE_BUCKETS = 8u;

// D.xyz is the gravity direction, D.w is the acceleration. Lower D.w for a gentler lean.
const vec4 D = vec4(0.0, -1.0, 0.0, 5.0);

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

vec3 safeNormalize(vec3 v, vec3 fallback) {
    float len2 = dot(v, v);
    return len2 > 1e-8 ? v * inversesqrt(len2) : fallback;
}

// Same facing vector as grass.tese: the blade's thin axis, spun around up.
vec3 faceDirection(float orientation, vec3 up) {
    vec3 face = vec3(cos(orientation), 0.0, sin(orientation));
    return safeNormalize(face - up * dot(face, up), vec3(1.0, 0.0, 0.0));
}

// Direction and strength at the blade root. Sines of position and time make a traveling gust.
vec3 windAt(vec3 root, float time) {
    float along = sin(time * 1.4 + root.x * 0.35 + root.z * 0.15);
    float across = cos(time * 0.8 + root.z * 0.28);
    float gust = 0.55 + 0.45 * sin(time * 0.35 + root.x * 0.08);
    return vec3(along, 0.0, 0.35 * across) * (4.0 * gust);
}

// Paper: wind matters more when the blade faces it, and more while the blade is still upright.
float windAlignment(vec3 wind, vec3 face, vec3 root, vec3 tip, vec3 up, float height) {
    float windLen2 = dot(wind, wind);
    if (windLen2 < 1e-8 || height < 1e-4) {
        return 0.0;
    }
    float directional = abs(dot(wind * inversesqrt(windLen2), face));
    float straight = clamp(dot(tip - root, up) / height, 0.0, 1.0);
    return directional * straight;
}

// Section 5.2. v2 stays above the ground, v1 follows the bend, and the curve length stays ~height.
void correctBlade(inout vec3 v1, inout vec3 v2, vec3 v0, vec3 up, float height) {
    // Equation 9: drop any component of (v2 - v0) that points through the ground.
    v2 -= up * min(dot(up, v2 - v0), 0.0);

    // Equations 10-11: v1 sits on the up axis, lower as v2 bends away from it.
    vec3 rel = v2 - v0;
    float lproj = length(rel - up * dot(rel, up));
    float ratio = lproj / height;
    float lift = max(1.0 - ratio, 0.05 * max(ratio, 1.0));
    v1 = v0 + height * up * lift;

    // Equations 12-13: quadratic Bezier length L = (2*L0 + L1) / 3, then scale both segments.
    float L0 = length(v2 - v0);
    float L1 = length(v1 - v0) + length(v2 - v1);
    float curveLength = (2.0 * L0 + L1) / 3.0;
    if (curveLength < 1e-4) {
        return;
    }
    float r = height / curveLength;
    vec3 mid = v0 + r * (v1 - v0);
    v2 = mid + r * (v2 - v1);
    v1 = mid;
}

vec3 cameraPosition() {
    return inverse(camera.view)[3].xyz;
}

// True when p is inside the real window. Vulkan depth is [0, w], and w <= 0 is behind the camera.
bool inWindow(vec3 p) {
    vec4 clip = camera.proj * camera.view * vec4(p, 1.0);
    if (clip.w <= 0.0) {
        return false;
    }
    return inBounds(clip.x, clip.w) && inBounds(clip.y, clip.w)
        && clip.z >= 0.0 && clip.z <= clip.w;
}

vec3 bezierPoint(float t, vec3 p0, vec3 p1, vec3 p2) {
    float s = 1.0 - t;
    return s * s * p0 + 2.0 * s * t * p1 + t * t * p2;
}

vec3 bezierTangent(float t, vec3 p0, vec3 p1, vec3 p2) {
    return 2.0 * (1.0 - t) * (p1 - p0) + 2.0 * t * (p2 - p1);
}

// The whole blade, including its width, must sit inside the window. One corner outside drops it,
// so the rasterizer never clips a tip and leaves half a blade on screen.
bool bladeFullyInside(vec3 v0, vec3 v1, vec3 v2, vec3 face, float width) {
    for (int i = 0; i <= 4; i++) {
        float t = float(i) * 0.25;
        vec3 center = bezierPoint(t, v0, v1, v2);
        vec3 tangent = safeNormalize(bezierTangent(t, v0, v1, v2), safeNormalize(v2 - v0, vec3(0.0, 1.0, 0.0)));
        vec3 side = safeNormalize(cross(tangent, face), vec3(1.0, 0.0, 0.0));
        // grass.tese: offset is (u - 0.5) * width * (1 - t), so the corners are half of that.
        float halfWidth = 0.5 * width * (1.0 - t);
        if (!inWindow(center + side * halfWidth) || !inWindow(center - side * halfWidth)) {
            return false;
        }
    }
    return true;
}

bool passesCulling(uint id, vec3 v0, vec3 v1, vec3 v2, vec3 up, vec3 face, float width) {
    vec3 cam = cameraPosition();
    vec3 viewDir = safeNormalize(cam - v0, vec3(0.0, 0.0, 1.0));
    // Width is perpendicular to the facing direction. Edge-on blades align with it.
    // ## orientation test 
    vec3 widthDir = safeNormalize(cross(up, face), vec3(0.0, 0.0, 1.0));
    if (abs(dot(viewDir, widthDir)) > ORIENTATION_THRESHOLD) {
        return false;
    }

    // ## view-frustum test
    // Drop the blade when any part of it, tip or width, leaves the window.
    if (!bladeFullyInside(v0, v1, v2, face, width)) {
        return false;
    }

    // Equation 19: distance along the ground, ignoring height above the plane.
    vec3 offset = v0 - cam;
    float dproj = length(offset - up * dot(offset, up));
    // ## distance test
    if (dproj >= MAX_CULL_DISTANCE) {
        return false;
    }
    // Closest bucket keeps every blade. Each farther bucket drops more of them,
    // and the last bucket drops all of them.
    // ## distance test
    uint kept = uint(floor(float(DISTANCE_BUCKETS) * (1.0 - dproj / MAX_CULL_DISTANCE)));
    if ((id % DISTANCE_BUCKETS) >= kept) {
        return false;
    }
    return true;
}

void main() {
    if (push.resetOnly != 0u) {
        if (gl_GlobalInvocationID.x == 0u) {
            numBlades.vertexCount = 0u;
        }
        return;
    }

	// Reset the number of blades to 0
	if (gl_GlobalInvocationID.x == 0) {
		// numBlades.vertexCount = 0;
	}
	barrier(); // Wait till all threads reach this point

    uint id = gl_GlobalInvocationID.x;
    if (id >= NUM_BLADES) {
        return;
    }

    // TODO: Apply forces on every blade and update the vertices in the buffer

    float dt = min(deltaTime, 0.05);

    Blade blade = blades[id];
    vec3 v0 = blade.v0.xyz;
    vec3 v1 = blade.v1.xyz;
    vec3 v2 = blade.v2.xyz;
    vec3 up = safeNormalize(blade.up.xyz, vec3(0.0, 1.0, 0.0));
    float height = max(blade.v1.w, 1e-4);
    float stiffness = blade.up.w;

    vec3 face = faceDirection(blade.v0.w, up);
    vec3 iv2 = v0 + up * height;

    vec3 gE = safeNormalize(D.xyz, vec3(0.0, -1.0, 0.0)) * D.w;
    vec3 gF = 0.25 * length(gE) * face;
    vec3 gravity = gE + gF;

    vec3 recovery = (iv2 - v2) * stiffness;

    vec3 windDir = windAt(v0, totalTime);
    vec3 wind = windDir * windAlignment(windDir, face, v0, v2, up, height);

    v2 += (gravity + recovery + wind) * dt; 
    // v2 += (gravity + recovery + wind) * dt;
    correctBlade(v1, v2, v0, up, height);

    blade.v1 = vec4(v1, blade.v1.w);
    blade.v2 = vec4(v2, blade.v2.w);
    blades[id] = blade;

	// TODO: Cull blades that are too far away or not in the camera frustum and write them
	// to the culled blades buffer
	// Note: to do this, you will need to use an atomic operation to read and update numBlades.vertexCount
	// You want to write the visible blades to the buffer without write conflicts between threads
    if (passesCulling(id, v0, v1, v2, up, face, blade.v2.w)) {
        uint slot = atomicAdd(numBlades.vertexCount, 1u);
        culledBlades[slot] = blade;
    }
}

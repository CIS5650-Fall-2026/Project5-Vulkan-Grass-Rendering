#version 450
#extension GL_ARB_separate_shader_objects : enable
#extension GL_KHR_shader_subgroup_ballot : enable

#define WORKGROUP_SIZE 32
layout(local_size_x = WORKGROUP_SIZE, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform CameraBufferObject {
    mat4 view;
    mat4 proj;
} camera;

layout(set = 1, binding = 0) uniform Time {
    float deltaTime;
    float totalTime;
};

struct Blade {
    vec4 v0;
    vec4 v1;
    vec4 v2;
    vec4 up;
};

layout(set = 2, binding = 0, std430) buffer AllBlades {
    Blade blades[];
};

layout(set = 2, binding = 1, std430) buffer CulledBlades {
    Blade culledBlades[];
};

layout(set = 2, binding = 2, std430) buffer NumBlades {
    uint vertexCount;
    uint instanceCount;
    uint firstVertex;
    uint firstInstance;
} numBlades;

#define GRAVITY 9.8
#define WIND_STRENGTH 6.0

// set from the command line; see Options.h
layout(constant_id = 0) const bool SUBGROUP_COMPACTION = true;  // warp aggregated atomic ballot
layout(constant_id = 1) const bool ORIENTATION_CULLING = true;
layout(constant_id = 2) const bool FRUSTUM_CULLING = true;
layout(constant_id = 3) const bool DISTANCE_CULLING = true;
layout(constant_id = 4) const bool FORCES = true;
layout(constant_id = 5) const bool WIND = true;

#define ORIENTATION_THRESHOLD 0.9
#define FRUSTUM_TOLERANCE 0.1
#define FULL_DENSITY_DISTANCE 15.0  // meters of ground distance kept at full density
#define MAX_DISTANCE 120.0
#define DISTANCE_BUCKETS 10

bool inBounds(float value, float bounds) {
    return (value >= -bounds) && (value <= bounds);
}

bool inFrustum(vec3 p, mat4 viewProj) {
    vec4 clip = viewProj * vec4(p, 1.0);
    float h = clip.w * (1.0 + FRUSTUM_TOLERANCE);
    return inBounds(clip.x, h) && inBounds(clip.y, h) && inBounds(clip.z, h);
}

// layered sines; frequencies are non-multiples of each other so the sum doesn't visibly repeat
void windAt(vec2 p, float t, out vec3 direction, out float strength) {
    float angle = 0.3 + 0.4 * sin(0.13 * t) + 0.2 * sin(0.31 * t + 1.7);
    vec2 baseDir = vec2(cos(angle), sin(angle));

    // weights sum to 1, so gust stays in [-1, 1]
    float gust = 0.5 * sin(0.35 * dot(p, baseDir) - 2.1 * t)
               + 0.3 * sin(0.9 * dot(p, vec2(0.8, -0.6)) - 3.7 * t + 1.3)
               + 0.2 * sin(2.3 * dot(p, vec2(-0.3, 0.95)) - 5.9 * t + 4.1);
    float envelope = 0.65 + 0.35 * sin(0.27 * t) * cos(0.11 * t + 0.6);
    strength = WIND_STRENGTH * envelope * (0.55 + 0.45 * gust);

    float flutter = 0.25 * sin(dot(p, vec2(1.7, 1.1)) - 4.3 * t);
    vec2 dir = normalize(baseDir + flutter * vec2(-baseDir.y, baseDir.x));
    direction = vec3(dir.x, 0.0, dir.y);
}

void main() {
	// vertexCount is zeroed by vkCmdFillBuffer before this dispatch
	// 2D dispatch past 65535 workgroups
	uint index = gl_GlobalInvocationID.y * gl_NumWorkGroups.x * gl_WorkGroupSize.x + gl_GlobalInvocationID.x;
	if (index >= blades.length()) {
		return;
	}

	Blade blade = blades[index];
	vec3 v0 = blade.v0.xyz;
	vec3 v1 = blade.v1.xyz;
	vec3 v2 = blade.v2.xyz;
	vec3 up = blade.up.xyz;
	float orientation = blade.v0.w;
	float height = blade.v1.w;
	float stiffness = blade.up.w;

	vec3 t1 = vec3(cos(orientation), 0.0, sin(orientation));

	if (FORCES) {
		// prevent overshooting at high dt
		float dt = min(deltaTime, 0.05);

		// forces
		vec3 front = normalize(cross(t1, up));
		vec3 gravity = vec3(0.0, -GRAVITY, 0.0) + 0.25 * GRAVITY * front;

		vec3 recovery = (v0 + up * height - v2) * stiffness;

		vec3 wind = vec3(0.0);
		if (WIND) {
			vec3 windDirection;
			float windStrength;
			windAt(v0.xz, totalTime, windDirection, windStrength);
			float directionalAlignment = 1.0 - abs(dot(windDirection, normalize(v2 - v0)));
			float heightRatio = dot(v2 - v0, up) / height;
			wind = windDirection * windStrength * directionalAlignment * heightRatio;
		}

		v2 += (gravity + recovery + wind) * dt;

		// state validation
		v2 -= up * min(dot(up, v2 - v0), 0.0);

		float lproj = length(v2 - v0 - up * dot(v2 - v0, up));
		v1 = v0 + height * up * max(1.0 - lproj / height, 0.05 * max(lproj / height, 1.0));

		// degree-2 curve length estimate
		float L0 = distance(v2, v0);
		float L1 = distance(v2, v1) + distance(v1, v0);
		float r = height / ((2.0 * L0 + L1) / 3.0);
		vec3 v1Corrected = v0 + r * (v1 - v0);
		v2 = v1Corrected + r * (v2 - v1);
		v1 = v1Corrected;

		blade.v1.xyz = v1;
		blade.v2.xyz = v2;
		blades[index] = blade;
	}

	// view is rigid, so its inverse translation is -R^T * t
	vec3 cameraPosition = -transpose(mat3(camera.view)) * camera.view[3].xyz;
	bool visible = true;

	if (ORIENTATION_CULLING) {
		// edge-on: looking along the width direction
		vec3 viewDirection = normalize(v0 - cameraPosition);
		visible = visible && abs(dot(viewDirection, t1)) < ORIENTATION_THRESHOLD;
	}

	if (FRUSTUM_CULLING) {
		mat4 viewProj = camera.proj * camera.view;
		vec3 midpoint = 0.25 * v0 + 0.5 * v1 + 0.25 * v2;
		visible = visible && (inFrustum(v0, viewProj) || inFrustum(midpoint, viewProj) || inFrustum(v2, viewProj));
	}

	if (DISTANCE_CULLING) {
		// one bucket fewer at each of 9 evenly spaced steps between FULL_DENSITY_DISTANCE and MAX_DISTANCE, none past it
		vec3 toBlade = v0 - cameraPosition;
		float groundDistance = length(toBlade - up * dot(toBlade, up));
		float fade = clamp((groundDistance - FULL_DENSITY_DISTANCE) / (MAX_DISTANCE - FULL_DENSITY_DISTANCE), 0.0, 1.0);
		float keptBuckets = ceil(DISTANCE_BUCKETS * (1.0 - fade));
		visible = visible && groundDistance < MAX_DISTANCE && float(index % DISTANCE_BUCKETS) < keptBuckets;
	}

	if (SUBGROUP_COMPACTION) {
		// one atomic per subgroup: the first lane reserves room for every visible lane
		uvec4 ballot = subgroupBallot(visible);
		uint base = 0;
		if (subgroupElect()) {
			base = atomicAdd(numBlades.vertexCount, subgroupBallotBitCount(ballot));
		}
		base = subgroupBroadcastFirst(base);
		if (visible) {
			culledBlades[base + subgroupBallotExclusiveBitCount(ballot)] = blade;
		}
	} else if (visible) {
		culledBlades[atomicAdd(numBlades.vertexCount, 1)] = blade;
	}
}
